<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LoginTimp</class>
 <widget class="QWidget" name="LoginTimp">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>420</width>
    <height>360</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Авторизация</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
  QWidget#LoginTimp {
      background-color: #f3f6fb; /* Светлый фон окна */
      font-family: Segoe UI, Arial, sans-serif;
      font-size: 14px;
  }

  /* Центральная карточка */
  QFrame#frame {
      background-color: #d9ecff; /* Светло-голубой */
      border-radius: 20px;
      border: 1px solid #bcd6f0;
      padding: 20px;
  }

  /* Заголовок */
  QLabel#titleLabel {
      font-size: 26px;
      font-weight: bold;
      color: #000000;
  }

  /* Подзаголовок */
  QLabel#subtitleLabel {
      font-size: 14px;
      color: #000000;
  }

  /* Обычные надписи */
  QLabel {
      color: #000000;
  }

  /* Поля ввода */
  QLineEdit {
      background-color: #ffffff;
      border: 2px solid #b0c4de;
      border-radius: 10px;
      padding: 8px;
      color: #000000;
  }

  QLineEdit:focus {
      border: 2px solid #4a90e2;
  }

  /* Кнопка входа */
  QPushButton#loginButton {
      background-color: #7fb800;
      color: #ffffff;
      border-radius: 12px;
      padding: 10px;
      font-size: 16px;
      font-weight: bold;
  }

  QPushButton#loginButton:hover {
      background-color: #95c11f;
  }

  QPushButton#loginButton:pressed {
      background-color: #6aa000;
  }

  /*"Забыли пароль?" */
  QLabel#forgotLabel {
      color: #1a73e8;
      text-decoration: underline;
  }

  /* Кнопка регистрации */
  QPushButton#registerButton {
      background-color: #4a90e2;
      color: white;
      border-radius: 10px;
      padding: 8px;
  }

  QPushButton#registerButton:hover {
      background-color: #5aa0f2;
  }
   </string>
  </property>

  <layout class="QVBoxLayout" name="mainLayout">
   <item alignment="Qt::AlignCenter">
    <widget class="QFrame" name="frame">
     <layout class="QVBoxLayout" name="verticalLayout">

      <item>
       <widget class="QLabel" name="titleLabel">
        <property name="text">
         <string>Авторизация</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignCenter</set>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="loginLabel">
        <property name="text">
         <string>Логин</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QLineEdit" name="usernameLineEdit">
        <property name="placeholderText">
         <string>Введите логин</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="passwordLabel">
        <property name="text">
         <string>Пароль</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QLineEdit" name="passwordLineEdit">
        <property name="echoMode">
         <enum>QLineEdit::Password</enum>
        </property>
        <property name="placeholderText">
         <string>Введите пароль</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QPushButton" name="loginButton">
        <property name="text">
         <string>Войти</string>
        </property>
       </widget>
      </item>

<item>
 <layout class="QHBoxLayout" name="bottomButtonsLayout">

  <item>
   <widget class="QPushButton" name="registerButton">
    <property name="text">
     <string>Зарегистрироваться</string>
    </property>
   </widget>
  </item>

  <item>
   <widget class="QLabel" name="forgotLabel">
    <property name="text">
     <string>&lt;a href="#"&gt;Забыли пароль?&lt;/a&gt;</string>
    </property>
    <property name="textFormat">
     <enum>Qt::RichText</enum>
    </property>
    <property name="textInteractionFlags">
     <set>Qt::TextBrowserInteraction</set>
    </property>
    <property name="openExternalLinks">
     <bool>false</bool>
    </property>
   </widget>
  </item>

 </layout>
</item>

<item>
 <layout class="QHBoxLayout" name="bottomLayout">
  <item>
   <spacer name="horizontalSpacer">
    <property name="orientation">
     <enum>Qt::Horizontal</enum>
    </property>
   </spacer>
  </item>
  <item>
   <widget class="QPushButton" name="backButton">
    <property name="text">
     <string>◀</string>
    </property>
    <property name="minimumSize">
     <size>
      <width>40</width>
      <height>30</height>
     </size>
    </property>
   </widget>
